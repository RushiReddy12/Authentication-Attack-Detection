// Synthetic unit tests for one-source password-spraying candidate detection.
// Expected: T1=1; T2,T3,T4=0.
// This harness tests one-IP spraying only, not distributed spraying.

let TestEvents = datatable(
    TestCase:string,
    EventTime:datetime,
    UserPrincipalName:string,
    IPAddress:string,
    ResultType:string
)
[
    // T1: one IP targets five distinct accounts => detect
    "T1", datetime(2026-01-01 10:00:00), "u1@lab.invalid", "10.0.0.8", "50126",
    "T1", datetime(2026-01-01 10:00:10), "u2@lab.invalid", "10.0.0.8", "50126",
    "T1", datetime(2026-01-01 10:00:20), "u3@lab.invalid", "10.0.0.8", "50126",
    "T1", datetime(2026-01-01 10:00:30), "u4@lab.invalid", "10.0.0.8", "50126",
    "T1", datetime(2026-01-01 10:00:40), "u5@lab.invalid", "10.0.0.8", "50126",

    // T2: one IP targets four accounts => below distinct-user threshold
    "T2", datetime(2026-01-01 10:00:00), "u1@lab.invalid", "10.0.0.9", "50126",
    "T2", datetime(2026-01-01 10:00:10), "u2@lab.invalid", "10.0.0.9", "50126",
    "T2", datetime(2026-01-01 10:00:20), "u3@lab.invalid", "10.0.0.9", "50126",
    "T2", datetime(2026-01-01 10:00:30), "u4@lab.invalid", "10.0.0.9", "50126",

    // T3: one account receives five failures => brute-force candidate, not spray
    "T3", datetime(2026-01-01 10:00:00), "alex@lab.invalid", "10.0.0.10", "50126",
    "T3", datetime(2026-01-01 10:00:10), "alex@lab.invalid", "10.0.0.10", "50126",
    "T3", datetime(2026-01-01 10:00:20), "alex@lab.invalid", "10.0.0.10", "50126",
    "T3", datetime(2026-01-01 10:00:30), "alex@lab.invalid", "10.0.0.10", "50126",
    "T3", datetime(2026-01-01 10:00:40), "alex@lab.invalid", "10.0.0.10", "50126",

    // T4: five successful sign-ins across five users => not failure-based spray
    "T4", datetime(2026-01-01 10:00:00), "u1@lab.invalid", "10.0.0.11", "0",
    "T4", datetime(2026-01-01 10:00:10), "u2@lab.invalid", "10.0.0.11", "0",
    "T4", datetime(2026-01-01 10:00:20), "u3@lab.invalid", "10.0.0.11", "0",
    "T4", datetime(2026-01-01 10:00:30), "u4@lab.invalid", "10.0.0.11", "0",
    "T4", datetime(2026-01-01 10:00:40), "u5@lab.invalid", "10.0.0.11", "0"
];
let ActualResults =
    TestEvents
    | where ResultType == "50126"
    | summarize
        FailedAttempts = count(),
        TargetedUsers = dcount(UserPrincipalName)
        by TestCase, IPAddress, bin(EventTime, 5m)
    | extend IsDetected = FailedAttempts >= 5 and TargetedUsers >= 5
    | summarize ActualDetectedGroups = countif(IsDetected) by TestCase;
let ExpectedResults = datatable(TestCase:string, ExpectedDetectedGroups:long)
[
    "T1", 1,
    "T2", 0,
    "T3", 0,
    "T4", 0
];
ExpectedResults
| join kind=leftouter ActualResults on TestCase
| extend ActualDetectedGroups = coalesce(ActualDetectedGroups, 0)
| extend TestResult = iff(ExpectedDetectedGroups == ActualDetectedGroups, "PASS", "FAIL")
| project TestCase, ExpectedDetectedGroups, ActualDetectedGroups, TestResult
| order by TestCase asc

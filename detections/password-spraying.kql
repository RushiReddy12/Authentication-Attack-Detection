// Detection: Password spraying candidate
// Grouping: one source IP + fixed 5-minute bucket across multiple accounts
// Lab threshold: >= 5 candidate failures against >= 5 distinct accounts
// This simple rule detects one-IP spraying patterns; distributed spraying needs
// additional logic and test coverage.
// Validate ResultType values and threshold against your tenant before deployment.

let Lookback = 24h;
let CandidateFailureCodes = dynamic(["50126"]);
SigninLogs
| where TimeGenerated >= ago(Lookback)
| where ResultType in (CandidateFailureCodes)
| where isnotempty(IPAddress)
| where isnotempty(UserPrincipalName)
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    TargetedUserList = make_set(UserPrincipalName, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    FailureCodes = make_set(ResultType, 10)
    by IPAddress, bin(TimeGenerated, 5m)
| where TargetedUsers >= 5 and FailedAttempts >= 5
| extend DetectionName = "Password spraying candidate"
| project
    TimeGenerated = LastSeen,
    DetectionName,
    IPAddress,
    FailedAttempts,
    TargetedUsers,
    TargetedUserList,
    FirstSeen,
    LastSeen,
    FailureCodes
| order by TargetedUsers desc
